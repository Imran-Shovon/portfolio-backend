NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio
JWT_SECRET=change-me-at-least-32-chars-long-please
JWT_EXPIRES_IN=7d
COOKIE_DOMAIN=
ADMIN_ORIGIN=http://localhost:3001
PUBLIC_BASE_URL=http://localhost:4000
UPLOAD_DIR=uploads
# local (disk, development) | vercel-blob | cloudinary (production: files survive redeploys)
STORAGE_DRIVER=local
# Set automatically on Vercel when a Blob store is connected to the project
BLOB_READ_WRITE_TOKEN=
# Required when STORAGE_DRIVER=cloudinary: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
STORAGE_FOLDER=portfolio
# Where the first website lives; `npm run seed` uses it for siteUrl / allowed origin / revalidate URL.
SEED_SITE_URL=http://localhost:3000
# Number of reverse proxies in front of the API (e.g. 1 behind nginx). 0 when exposed directly.
TRUST_PROXY=0
ADMIN_EMAIL=
ADMIN_PASSWORD=
